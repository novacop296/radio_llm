# ==============================================================================
# LLM-Assisted Explainable Radiology Report Generation
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your local settings:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# IMPORTANT: Never commit your actual .env file or real API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options:
#   - "mock"   : Deterministic, offline mock provider (Recommended for local dev & testing)
#   - "openai" : OpenAI-compatible chat completions API (Requires valid LLM_API_KEY)
LLM_PROVIDER=mock

# Model identifier
# Defaults: "mock-radiology-llm" (for mock), "gpt-4o-mini" (for openai)
LLM_MODEL=mock-radiology-llm

# Temperature for sampling (0.0 recommended for deterministic clinical synthesis)
LLM_TEMPERATURE=0.0

# Maximum token budget for report generation
LLM_MAX_TOKENS=1024

# Network timeout in seconds
LLM_TIMEOUT=30

# Maximum retry attempts on API rate-limits / transient network failures
LLM_RETRY_COUNT=3

# API Key for OpenAI-compatible provider (Leave blank when using LLM_PROVIDER=mock)
# LLM_API_KEY=your_openai_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
